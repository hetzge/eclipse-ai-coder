<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.ui.startup">
      <startup
            class="de.hetzge.eclipse.aicoder.AiCoderStartup">
      </startup>
   </extension>

	<extension point="org.eclipse.ui.commands">
  <command
        categoryId="de.hetzge.eclipse.codestral.commands.inlineCompletion"
        id="de.hetzge.eclipse.codestral.commands.toggleMultiline"
        name="Multiline Completion">
     <state
           class="org.eclipse.jface.commands.ToggleState"
           id="org.eclipse.ui.commands.toggleState">
     </state>
  </command>
		<category
        id="de.hetzge.eclipse.codestral.commands.inlineCompletion"
        name="AI Code Completion">
  </category>
		<command
			categoryId="de.hetzge.eclipse.codestral.commands.inlineCompletion"
			name="Trigger Inline Completion"
			id="de.hetzge.eclipse.codestral.commands.inlineCompletion.trigger">
		</command>
		<command
			categoryId="de.hetzge.eclipse.codestral.commands.inlineCompletion"
			name="Accept Inline Completion"
			id="de.hetzge.eclipse.codestral.commands.inlineCompletion.accept">
		</command>
		<command
			categoryId="de.hetzge.eclipse.codestral.commands.inlineCompletion"
			name="Accept Line"
			id="de.hetzge.eclipse.codestral.commands.acceptLine">
		</command>
		<command
			categoryId="de.hetzge.eclipse.codestral.commands.inlineCompletion"
			name="Dismiss Inline Completion"
			id="de.hetzge.eclipse.codestral.commands.inlineCompletion.dismiss">
		</command>
  <command
        id="de.hetzge.eclipse.codestral.commands.triggerInstruction"
        name="Trigger Instruction">
  </command>
  <command
        id="de.hetzge.eclipse.codestral.commands.startAgent"
        name="Start Agent">
  </command>
  <command
        id="de.hetzge.eclipse.codestral.commands.triggerNextEdit"
        name="Trigger Next Edit">
  </command>
  <command
        id="de.hetzge.eclipse.codestral.commands.dumpOutline"
        name="Dump Outline">
  </command>
  <command
        id="de.hetzge.eclipse.codestral.commands.resetCodeViewportMemory"
        name="Reset Code Viewport Memory">
  </command>
	</extension>

	<extension point="org.eclipse.ui.handlers">
		<handler
			class="de.hetzge.eclipse.aicoder.handler.TriggerHandler"
			commandId="de.hetzge.eclipse.codestral.commands.inlineCompletion.trigger">
		</handler>
		<handler
			class="de.hetzge.eclipse.aicoder.handler.AcceptHandler"
			commandId="de.hetzge.eclipse.codestral.commands.inlineCompletion.accept">
		</handler>
		<handler
			class="de.hetzge.eclipse.aicoder.handler.DismissHandler"
			commandId="de.hetzge.eclipse.codestral.commands.inlineCompletion.dismiss">
		</handler>
  <handler
        class="de.hetzge.eclipse.aicoder.handler.ToggleMultilineHandler"
        commandId="de.hetzge.eclipse.codestral.commands.toggleMultiline">
  </handler>
  <handler
        class="de.hetzge.eclipse.aicoder.handler.TriggerInstructionHandler"
        commandId="de.hetzge.eclipse.codestral.commands.triggerInstruction">
  </handler>
  <handler
        class="de.hetzge.eclipse.aicoder.handler.StartAgentHandler"
        commandId="de.hetzge.eclipse.codestral.commands.startAgent">
  </handler>
  	<handler
        class="de.hetzge.eclipse.aicoder.handler.TriggerNextEditHandler"
        commandId="de.hetzge.eclipse.codestral.commands.triggerNextEdit">
  </handler>
  <handler
        class="de.hetzge.eclipse.aicoder.handler.DumpOutlineHandler"
        commandId="de.hetzge.eclipse.codestral.commands.dumpOutline">
  </handler>
  <handler
        class="de.hetzge.eclipse.aicoder.handler.ResetCodeViewportMemoryHandler"
        commandId="de.hetzge.eclipse.codestral.commands.resetCodeViewportMemory">
  </handler>
  <handler
        class="de.hetzge.eclipse.aicoder.handler.AcceptLineHandler"
        commandId="de.hetzge.eclipse.codestral.commands.acceptLine">
  </handler>
	</extension>

	<extension
       point="org.eclipse.ui.bindings">
    <key
          commandId="de.hetzge.eclipse.codestral.commands.inlineCompletion.trigger"
          contextId="org.eclipse.ui.textEditorScope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+SPACE">
    </key>
    <key
          commandId="de.hetzge.eclipse.codestral.commands.inlineCompletion.accept"
          contextId="de.hetzge.eclipse.aicoder.inlineCompletionVisible"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="TAB">
    </key>
    <key
          commandId="de.hetzge.eclipse.codestral.commands.acceptLine"
          contextId="de.hetzge.eclipse.aicoder.inlineCompletionVisible"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+M3+ARROW_DOWN">
    </key>
    <key
          commandId="de.hetzge.eclipse.codestral.commands.inlineCompletion.dismiss"
          contextId="de.hetzge.eclipse.aicoder.inlineCompletionVisible"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="ESC">
    </key>
    <key
          commandId="de.hetzge.eclipse.codestral.commands.triggerInstruction"
          contextId="org.eclipse.ui.textEditorScope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+1">
    </key>
 </extension>

	<extension point="org.eclipse.ui.contexts">
		<context
			id="de.hetzge.eclipse.aicoder.inlineCompletionVisible"
			name="Inline Completion Visible"
			description="Inline completion visible"
			parentId="org.eclipse.ui.textEditorScope">
		</context>
	</extension>
 <extension
       point="org.eclipse.ui.views">
    <category
          id="de.hetzge.eclipse.aicoder"
          name="AI Coder">
    </category>
    <view
          category="de.hetzge.eclipse.aicoder"
          class="de.hetzge.eclipse.aicoder.ContextView"
          icon="icons/icon16.png"
          id="de.hetzge.eclipse.aicoder.ContextView"
          inject="true"
          name="AI Coder Context">
    </view>
    <view
          category="de.hetzge.eclipse.aicoder"
          class="de.hetzge.eclipse.aicoder.history.AiCoderHistoryView"
          icon="icons/icon16.png"
          id="de.hetzge.eclipse.aicoder.AiCoderHistoryView"
          inject="true"
          name="AI Coder History">
    </view>
    <view
          category="de.hetzge.eclipse.aicoder"
          class="de.hetzge.eclipse.aicoder.agent.AgentTaskTreeView"
          icon="icons/icon16.png"
          id="de.hetzge.eclipse.aicoder.AgentTaskTreeView"
          inject="true"
          name="AI Coder Tasks">
    </view>
 </extension>
 <extension
       point="org.eclipse.ui.perspectiveExtensions">
    <perspectiveExtension
          targetID="org.eclipse.jdt.ui.JavaPerspective">
       <view
             id="de.hetzge.eclipse.aicoder.ContextView"
             ratio="0.5"
             relationship="stack"
             relative="org.eclipse.ui.views.ContentOutline">
       </view>
       <view
             id="de.hetzge.eclipse.aicoder.AiCoderHistoryView"
             ratio="0.5"
             relationship="stack"
             relative="org.eclipse.ui.views.ProblemView">
       </view>
       <view
             id="de.hetzge.eclipse.aicoder.AgentTaskTreeView"
             ratio="0.5"
             relationship="stack"
             relative="org.eclipse.ui.navigator.ProjectExplorer">
       </view>
    </perspectiveExtension>
 </extension>
 <extension
        point="org.eclipse.ui.preferencePages">
     <page
           class="de.hetzge.eclipse.aicoder.preferences.AiCoderPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences"
           name="AI Coder">
     </page>
     <page
           category="de.hetzge.eclipse.aicoder.preferences"
           class="de.hetzge.eclipse.aicoder.preferences.GeneralPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences.general"
           name="General">
     </page>
     <page
           category="de.hetzge.eclipse.aicoder.preferences"
           class="de.hetzge.eclipse.aicoder.preferences.ContextPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences.context"
           name="Context">
     </page>
     <page
           category="de.hetzge.eclipse.aicoder.preferences"
           class="de.hetzge.eclipse.aicoder.preferences.ProviderPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences.provider"
           name="Provider">
     </page>
     <page
           category="de.hetzge.eclipse.aicoder.preferences.provider"
           class="de.hetzge.eclipse.aicoder.preferences.OllamaPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences.ollama"
           name="Ollama">
     </page>
     <page
           category="de.hetzge.eclipse.aicoder.preferences.provider"
           class="de.hetzge.eclipse.aicoder.preferences.MistralPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences.mistral"
           name="Mistral">
     </page>
     <page
           category="de.hetzge.eclipse.aicoder.preferences.provider"
           class="de.hetzge.eclipse.aicoder.preferences.OpenAIPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences.openai"
           name="OpenAI">
     </page>
     <page
           category="de.hetzge.eclipse.aicoder.preferences.provider"
           class="de.hetzge.eclipse.aicoder.preferences.InceptionlabsPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences.inceptionlabs"
           name="Inceptionlabs">
     </page>
     <page
           category="de.hetzge.eclipse.aicoder.preferences.provider"
           class="de.hetzge.eclipse.aicoder.preferences.OpenRouterPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences.openrouter"
           name="OpenRouter">
     </page>
     <page
           category="de.hetzge.eclipse.aicoder.preferences"
           class="de.hetzge.eclipse.aicoder.preferences.McpPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences.mcp"
           name="MCP">
     </page>
     <page
           category="de.hetzge.eclipse.aicoder.preferences"
           class="de.hetzge.eclipse.aicoder.preferences.LlmPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences.llm"
           name="LLM">
     </page>
     <page
           category="de.hetzge.eclipse.aicoder.preferences"
           class="de.hetzge.eclipse.aicoder.preferences.PromptsPreferencePage"
           id="de.hetzge.eclipse.aicoder.preferences.prompts"
           name="Prompts">
     </page>
  </extension> 
 <extension
       point="org.eclipse.core.runtime.preferences">
    <initializer
          class="de.hetzge.eclipse.aicoder.preferences.AiCoderPreferences">
    </initializer>
 </extension>
 <extension
       point="org.eclipse.ui.quickAccess">
    <computer
          class="de.hetzge.eclipse.aicoder.AiCoderInstructionsQuickAccessComputer"
          name="AI Coder Instructions"
          requiresUIAccess="false">
    </computer>
 </extension>
 <extension
       point="org.eclipse.ui.editors">
    <editor
          class="de.hetzge.eclipse.aicoder.agent.AgentTrajectoryEditor"
          contributorClass="org.eclipse.ui.texteditor.BasicTextEditorActionContributor"
          default="false"
          icon="icons/icon16.png"
          id="de.hetzge.eclipse.aicoder.AgentTrajectoryEditor"
          name="AI Coder Trajectory">
    </editor>
 </extension>
</plugin>
