          id="de.hetzge.eclipse.aicoder.AgentTaskTreeView"
          inject="true"
          name="AI Coder Tasks">
    </view>
    <view
          category="de.hetzge.eclipse.aicoder"
          class="de.hetzge.eclipse.aicoder.ScratchpadView"
          icon="icons/icon16.png"
          id="de.hetzge.eclipse.aicoder.ScratchpadView"
          inject="true"
          name="AI Coder Scratchpad">
    </view>
    <view
          category="de.hetzge.eclipse.aicoder"
          class="de.hetzge.eclipse.aicoder.AiCoderResultView"
          icon="icons/icon16.png"
          id="de.hetzge.eclipse.aicoder.AiCoderResultView"
          inject="true"
          name="AI Coder Result">
    </view>
 </extension>
 <extension
       point="org.eclipse.ui.perspectiveExtensions">
    <perspectiveExtension
          targetID="org.eclipse.jdt.ui.JavaPerspective">
       <view
             id="de.hetzge.eclipse.aicoder.ContextView"
             ratio="0.5"
             relationship="stack"
             relative="org.eclipse.ui.views.ContentOutline">
       </view>
       <view
             id="de.hetzge.eclipse.aicoder.AiCoderHistoryView"
             ratio="0.5"
             relationship="stack"
             relative="org.eclipse.ui.views.ProblemView">
       </view>
       <view
             id="de.hetzge.eclipse.aicoder.AgentTaskTreeView"
             ratio="0.5"
             relationship="stack"
             relative="org.eclipse.ui.navigator.ProjectExplorer">
       </view>
    </perspectiveExtension>
 </extension>
