            class="de.hetzge.eclipse.aicoder.AiCoderStartup">
      </startup>
   </extension>

	<extension point="org.eclipse.ui.commands">
  <command
        categoryId="de.hetzge.eclipse.codestral.commands.inlineCompletion"
        id="de.hetzge.eclipse.codestral.commands.toggleMultiline"
        name="Multiline Completion">
     <state
           class="org.eclipse.jface.commands.ToggleState"
           id="org.eclipse.ui.commands.toggleState">
     </state>
  </command>
		<category
        id="de.hetzge.eclipse.codestral.commands.inlineCompletion"
        name="AI Code Completion">
  </category>
		<command
			categoryId="de.hetzge.eclipse.codestral.commands.inlineCompletion"
			name="Trigger Inline Completion"
			id="de.hetzge.eclipse.codestral.commands.inlineCompletion.trigger">
		</command>
		<command
			categoryId="de.hetzge.eclipse.codestral.commands.inlineCompletion"
			name="Accept Inline Completion"
			id="de.hetzge.eclipse.codestral.commands.inlineCompletion.accept">
		</command>
		<command
			categoryId="de.hetzge.eclipse.codestral.commands.inlineCompletion"
			name="Accept Line"
			id="de.hetzge.eclipse.codestral.commands.acceptLine">
		</command>
		<command
			categoryId="de.hetzge.eclipse.codestral.commands.inlineCompletion"
			name="Dismiss Inline Completion"
			id="de.hetzge.eclipse.codestral.commands.inlineCompletion.dismiss">
		</command>
  <command
        id="de.hetzge.eclipse.codestral.commands.triggerInstruction"
        name="Trigger Instruction">
  </command>
  <command
        id="de.hetzge.eclipse.codestral.commands.startAgent"
        name="Start Agent">
  </command>
  <command
        id="de.hetzge.eclipse.codestral.commands.triggerNextEdit"
        name="Trigger Next Edit">
  </command>
  <command
        id="de.hetzge.eclipse.codestral.commands.dumpOutline"
        name="Dump Outline">
  </command>
  <command
        id="de.hetzge.eclipse.codestral.commands.resetCodeViewportMemory"
        name="Reset Code Viewport Memory">
  </command>
  <command
        id="de.hetzge.eclipse.codestral.commands.abortAgentTask"
        name="Abort Task(s)">
  </command>
  <command
        id="de.hetzge.eclipse.codestral.commands.abortAllAgentTasks"
        name="Abort All Tasks">
  </command>
  <command
        id="de.hetzge.eclipse.aicoder.commands.scratchpadAddPlain"
        name="Add to Scratchpad (Plain)">
  </command>
  <command
        id="de.hetzge.eclipse.aicoder.commands.scratchpadAddWithPath"
        name="Add to Scratchpad (With Path)">
  </command>
  <command
        id="de.hetzge.eclipse.aicoder.commands.scratchpadAddWithXmlTag"
