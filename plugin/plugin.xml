 <extension
       point="org.eclipse.ui.menus">
    <menuContribution
          locationURI="popup:#AbstractTextEditorContext?after=additions">
       <menu
             id="de.hetzge.eclipse.aicoder.menu.addToScratchpad"
             label="AI Coder"
             icon="icons/icon16.png">
          <menu
                id="de.hetzge.eclipse.aicoder.menu.addToScratchpad.sub"
                label="Add to scratchpad">
             <command
                   commandId="de.hetzge.eclipse.aicoder.commands.scratchpadAddPlain"
                   label="Plain"
                   style="push">
             </command>
             <command
                   commandId="de.hetzge.eclipse.aicoder.commands.scratchpadAddWithPath"
                   label="With path"
                   style="push">
             </command>
             <command
                   commandId="de.hetzge.eclipse.aicoder.commands.scratchpadAddWithXmlTag"
                   label="With XML tag"
                   style="push">
             </command>
             <command
                   commandId="de.hetzge.eclipse.aicoder.commands.scratchpadAddWithMarkdownCode"
                   label="With Markdown code"
                   style="push">
             </command>
          </menu>
          <command
                commandId="de.hetzge.eclipse.aicoder.commands.scratchpadReplaceContent"
                label="Replace scratchpad content"
                style="push">
          </command>
       </menu>
    </menuContribution>
    <menuContribution
          allPopups="true"
          locationURI="popup:org.eclipse.ui.popup.any?after=additions">
       <menu
             id="de.hetzge.eclipse.aicoder.menu.addToScratchpadFile"
             label="AI Coder"
             icon="icons/icon16.png">
          <visibleWhen
                checkEnabled="false">
             <with
                   variable="selection">
                <count
                      value="+">
                </count>
                <iterate
                      ifEmpty="false"
                      operator="or">
                   <or>
                      <adapt
                            type="org.eclipse.core.resources.IFile">
                      </adapt>
                      <adapt
                            type="org.eclipse.jdt.core.ICompilationUnit">
                      </adapt>
                   </or>
                </iterate>
             </with>
          </visibleWhen>
          <menu
                id="de.hetzge.eclipse.aicoder.menu.addToScratchpadFile.sub"
                label="Add to scratchpad">
             <command
                   commandId="de.hetzge.eclipse.aicoder.commands.scratchpadAddPlain"
                   label="Plain"
                   style="push">
             </command>
             <command
                   commandId="de.hetzge.eclipse.aicoder.commands.scratchpadAddWithPath"
                   label="With path"
                   style="push">
             </command>
             <command
                   commandId="de.hetzge.eclipse.aicoder.commands.scratchpadAddWithXmlTag"
                   label="With XML tag"
                   style="push">
             </command>
             <command
                   commandId="de.hetzge.eclipse.aicoder.commands.scratchpadAddWithMarkdownCode"
                   label="With Markdown code"
                   style="push">
             </command>
          </menu>
          <command
                commandId="de.hetzge.eclipse.aicoder.commands.scratchpadReplaceContent"
                label="Replace scratchpad content"
                style="push">
          </command>
       </menu>
    </menuContribution>
