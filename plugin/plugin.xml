	<extension
       point="org.eclipse.ui.bindings">
    <key
          commandId="de.hetzge.eclipse.codestral.commands.inlineCompletion.trigger"
          contextId="org.eclipse.ui.textEditorScope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+SPACE">
    </key>
    <key
          commandId="de.hetzge.eclipse.codestral.commands.inlineCompletion.accept"
          contextId="de.hetzge.eclipse.aicoder.inlineCompletionVisible"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="TAB">
    </key>
    <key
          commandId="de.hetzge.eclipse.codestral.commands.acceptLine"
          contextId="de.hetzge.eclipse.aicoder.inlineCompletionVisible"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+M3+ARROW_DOWN">
    </key>
    <key
          commandId="de.hetzge.eclipse.codestral.commands.inlineCompletion.dismiss"
          contextId="de.hetzge.eclipse.aicoder.inlineCompletionVisible"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="ESC">
    </key>
    <key
          commandId="de.hetzge.eclipse.codestral.commands.triggerInstruction"
          contextId="org.eclipse.ui.textEditorScope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+1">
    </key>
    <key
          commandId="de.hetzge.eclipse.codestral.commands.triggerInstruction"
          contextId="org.eclipse.ui.contexts.dialogAndWindow"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+1">
    </key>
    <key
          commandId="de.hetzge.eclipse.codestral.commands.startAgent"
          contextId="org.eclipse.ui.textEditorScope"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+2">
    </key>
    <key
          commandId="de.hetzge.eclipse.codestral.commands.startAgent"
          contextId="org.eclipse.ui.contexts.dialogAndWindow"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="M1+M2+2">
    </key>
 </extension>
	<extension point="org.eclipse.ui.contexts">
		<context
			id="de.hetzge.eclipse.aicoder.inlineCompletionVisible"
			name="AI Coder: Inline completion visible"
			description="Inline completion visible"
			parentId="org.eclipse.ui.textEditorScope">
		</context>
	</extension>
